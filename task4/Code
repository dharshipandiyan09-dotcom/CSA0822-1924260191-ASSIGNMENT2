import time 
def build_plus(parts): 
    text = "" 
    for p in parts: 
        text += p + ";" 
    return text 
def build_join(parts): 
    return ";".join(parts) + ";" 
def build_fstring(parts): 
    formatted = [f"{p}" for p in parts] 
    return ";".join(formatted) + ";" 
sizes = [1000, 10000, 200000] 
for n in sizes: 
    items = [ 
        f"Item{i}: Rs.{i % 50}" 
        for i in range(n) 
    ] 
    plus_times = [] 
    join_times = [] 
    fstring_times = [] 
    for _ in range(3): 
        start = time.perf_counter() 
        a = build_plus(items) 
        plus_times.append(time.perf_counter() - start) 
        start = time.perf_counter() 
        b = build_join(items) 
        join_times.append(time.perf_counter() - start) 
        start = time.perf_counter() 
        c = build_fstring(items) 
        fstring_times.append(time.perf_counter() - start) 
    print("\nNumber of lines:", n) 
    print("Same text:", a == b == c) 
    print("Length:", len(a)) 
    print("Average += time:", 
          sum(plus_times) / 3) 
    print("Average join time:", 
          sum(join_times) / 3) 
    print("Average f-string time:", 
          sum(fstring_times) / 3) 

