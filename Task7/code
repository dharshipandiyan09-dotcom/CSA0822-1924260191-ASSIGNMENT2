import time 
from functools import lru_cache 
@lru_cache(maxsize=None) 
def ways_memo(n): 
    if n <= 1: 
        return 1 
    return ways_memo(n - 1) + ways_memo(n - 2) 
def ways_loop(n): 
    if n <= 1: 
        return 1 
    previous = 1 
    current = 1 
    for i in range(2, n + 1): 
        previous, current = ( 
            current, 
            previous + current 
        ) 
    return current 
n = 1000 
start = time.perf_counter() 
try: 
    original = ways_memo(n) 
    print("Original result:", original) 
except RecursionError: 
    print("Original: RecursionError") 
original_time = time.perf_counter() - start 
start = time.perf_counter() 
redesigned = ways_loop(n) 
redesigned_time = time.perf_counter() - start 
print("Redesigned result:", redesigned) 
print("Number of digits:", len(str(redesigned))) 
print("Original time:", 
      round(original_time, 6), "seconds") 
print("Redesigned time:", 
      round(redesigned_time, 6), "seconds") 

